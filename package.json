{
  "name": "haftdast",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --clear-screen=false --exclude src/app/** --exclude src/components/** --exclude src/i18n/** --exclude src/lib/** --exclude .next/** --exclude public/** server.ts",
    "build": "node scripts/gen-icons.mjs && next build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "simulate": "tsx scripts/simulate.ts",
    "icons": "node scripts/gen-icons.mjs",
    "smoke": "tsx scripts/online-smoke.ts",
    "online": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/play-online.ps1",
    "faces": "node scripts/gen-face-webp.mjs"
  },
  "dependencies": {
    "cross-env": "^10.1.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
